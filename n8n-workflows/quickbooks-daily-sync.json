            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Invoices (Last 30 Days)": {
      "main": [
        [
          {
            "node": "Merge All Transactions",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Merge All Transactions": {
      "main": [
        [
          {
