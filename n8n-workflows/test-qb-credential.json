{
  "name": "Test QuickBooks Credential",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Click to Test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "https://sandbox-quickbooks.api.intuit.com/v3/company/={{$credentials.realmId}}/companyinfo/={{$credentials.realmId}}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "quickBooksOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "test-qb",
      "name": "Test QuickBooks Connection",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 300],
      "credentials": {
        "quickBooksOAuth2Api": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "QuickBooks OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const qbData = $input.first().json;\n\nif (qbData.CompanyInfo) {\n  return {\n    json: {\n      status: 'SUCCESS',\n      message: '✅ QuickBooks credential is working!',\n      companyName: qbData.CompanyInfo.CompanyName,\n      realmId: qbData.CompanyInfo.Id,\n      nextStep: 'Update workflow URLs to your production domain'\n    }\n  };\n} else {\n  return {\n    json: {\n      status: 'ERROR',\n      message: '❌ QuickBooks credential failed',\n      error: qbData,\n      fix: 'Click Reconnect in credential and authorize again'\n    }\n  };\n}"
      },
      "id": "check-result",
      "name": "Check Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    }
  ],
  "connections": {
    "Click to Test": {
      "main": [
        [
          {
            "node": "Test QuickBooks Connection",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Test QuickBooks Connection": {
      "main": [
        [
          {
            "node": "Check Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
