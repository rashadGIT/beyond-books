# Database (SQLite for local dev; PostgreSQL for production)
# Local:      DATABASE_URL="file:./dev.db"
# Production: DATABASE_URL="postgresql://user:pass@rds-endpoint:5432/beyondbooks"
DATABASE_URL="file:./dev.db"

# Application URL
NEXT_PUBLIC_URL="http://localhost:3000"

# QuickBooks OAuth Configuration
# Get these from: https://developer.intuit.com/app/developer/myapps
QUICKBOOKS_CLIENT_ID="your_client_id_here"
QUICKBOOKS_CLIENT_SECRET="your_client_secret_here"
QUICKBOOKS_REDIRECT_URI="http://localhost:3000/api/quickbooks/callback"
QUICKBOOKS_ENVIRONMENT="sandbox" # or "production"

# AWS Cognito Auth
AWS_REGION="us-east-1"
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""
COGNITO_DOMAIN=""

# Public Cognito vars (exposed to browser for Google OAuth redirect)
NEXT_PUBLIC_COGNITO_DOMAIN=""
NEXT_PUBLIC_COGNITO_CLIENT_ID=""

# AI Provider (app-level — users never see this)
# Supported: anthropic | openai | google
AI_PROVIDER="openai"
AI_API_KEY=""
AI_MODEL="gpt-4o"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# S3 Storage (one bucket with uploads/ and pdfs/ folders)
AWS_S3_BUCKET=""            # e.g. beyond-books-app
CHROMIUM_PATH=""            # Production only: @sparticuz/chromium-min S3 remote URL

# Scheduler Configuration
CRON_SECRET=""              # Generate with: openssl rand -hex 32
SCHEDULER_TIMEZONE="America/Chicago"  # e.g. America/New_York, America/Chicago, America/Los_Angeles
DISABLE_SCHEDULER="false"
